# Environment variables (copy to hosting dashboard or a local `.env` file)

# Required for production
ENVIRONMENT=production
SECRET_KEY=generate-a-long-random-string-here
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Initial admin (created on first startup if no users exist)
ADMIN_EMAIL=you@cwrtmalle.co.uk
ADMIN_PASSWORD=use-a-strong-password-min-12-chars

# Optional
SESSION_MAX_AGE_SECONDS=43200
MIN_PASSWORD_LENGTH=12
COOKIE_SECURE=true

# Local development example
# ENVIRONMENT=development
# DATABASE_URL=sqlite:///data/wynnstay.db
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=localdevpassword

# One-off local → Render migration (scripts/migrate_sqlite_to_postgres.py)
# TARGET_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Herd data import from OneDrive (DCEXPORT CSV files)
# Register an app in Microsoft Entra → App registrations (application permission Sites.Read.All or Files.Read.All, admin consent)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# OneDrive owner of the export folder (your work email)
GRAPH_DRIVE_USER_EMAIL=you@greenacredairy.co.uk
# Path to folder containing DCEXPORTCM / DCEXPORTGAD (no leading slash)
HERD_EXPORT_BASE_PATH=Power BI Reports/Cwrt Malle and GAD Costings
# Long random string for cron / automated POST /api/herd/events/import (header: X-Import-Key)
IMPORT_API_KEY=

# Local dev: read CSVs from synced OneDrive folder instead of Graph API
# LOCAL_HERD_EXPORT_DIR=C:\Users\you\OneDrive - greenacredairy.co.uk\Power BI Reports\Cwrt Malle and GAD Costings

# Feedlync feed rate import (HTTP API — no browser required)
# On first deploy you can set FEEDLYNC_REFRESH_TOKEN once; after that use Feed Rate → Reconnect FeedLync.
# The app stores and rotates the token in the database automatically.
FEEDLYNC_REFRESH_TOKEN=
# Public URL of this app (OAuth callback). Defaults to RENDER_EXTERNAL_URL on Render.
# PUBLIC_APP_URL=https://your-app.onrender.com
# Optional: comma-separated farm UUIDs; if unset, all farms from /farms/summary are imported
# FEEDLYNC_FARM_ID=ca4e4709-5e57-4b3f-8f6e-08dc5df96c65

# Unattended FeedLync login (recommended for cron). FeedLync's B2C SPA refresh
# tokens expire ~24h, so a stored/pasted token won't survive between weekly runs.
# With these set, the importer logs in automatically (replicating the B2C
# sign-in flow) and refreshes the token on each run. Account must have NO MFA.
# Treat the password as a secret; never commit it.
# FEEDLYNC_USERNAME=you@example.com
# FEEDLYNC_PASSWORD=
# Registered SPA redirect URI (intercepted server-side; default is correct).
# FEEDLYNC_SPA_REDIRECT_URI=https://app.feedlync.com/redirect.html

# HR / Staff management (DocuSeal contract signing)
# DOCUSEAL_API_KEY=from DocuSeal console → API
# DOCUSEAL_BASE_URL=https://api.docuseal.com
# DOCUSEAL_WEBHOOK_SECRET=long-random-string (append to webhook URL or X-Webhook-Secret header)
# HR_ENCRYPTION_KEY=optional Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# HR_HR_TEAM_EMAILS=hr1@example.com,hr2@example.com
# CONTRACTS_STORAGE_DIR=/var/data/contracts
# DOCUSEAL_CWRTMALLE_TEMPLATE_ID=12345
# DOCUSEAL_CWRTMALLE_TEMPLATE_NAME=Cwrt Malle Employment Contract

# Environment variables (copy to hosting dashboard or a local `.env` file)

# Required for production
ENVIRONMENT=production
SECRET_KEY=generate-a-long-random-string-here
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Initial admin (created on first startup if no users exist)
ADMIN_EMAIL=you@cwrtmalle.co.uk
ADMIN_PASSWORD=use-a-strong-password-min-12-chars

# Optional
SESSION_MAX_AGE_SECONDS=43200
MIN_PASSWORD_LENGTH=12
COOKIE_SECURE=true

# Local development example
# ENVIRONMENT=development
# DATABASE_URL=sqlite:///data/wynnstay.db
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=localdevpassword

# One-off local → Render migration (scripts/migrate_sqlite_to_postgres.py)
# TARGET_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# One-off production → local ration data (scripts/sync_benchmarking_from_production.py)
# SOURCE_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Herd data import from OneDrive (DCEXPORT CSV files)
# Register an app in Microsoft Entra → App registrations (application permission Sites.Read.All or Files.Read.All, admin consent)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# OneDrive owner of the export folder (your work email)
GRAPH_DRIVE_USER_EMAIL=you@greenacredairy.co.uk
# For Office Admin → Pedigree Registrations email export, also grant Mail.Send
# application permission on the same Entra app (admin consent required).
# Path to folder containing DCEXPORTCM / DCEXPORTGAD (no leading slash)
HERD_EXPORT_BASE_PATH=Power BI Reports/Cwrt Malle and GAD Costings
# Long random string for cron / automated POST /api/herd/events/import (header: X-Import-Key)
IMPORT_API_KEY=

# Local dev: read CSVs from synced OneDrive folder instead of Graph API
# LOCAL_HERD_EXPORT_DIR=C:\Users\you\OneDrive - greenacredairy.co.uk\Power BI Reports\Cwrt Malle and GAD Costings

# NML milk-quality results (emailed PDF reports from National Milk Laboratories)
# Requires the Mail.Read application permission on the same Entra app (admin consent).
# Ideally scope it to just these mailboxes via an Exchange application access policy.
# NML_SENDER=milk.autoemail@nationalmilklabs.com
# NML_SENDER_DOMAIN=nationalmilklabs.com
# NML_MAILBOX_GAD=steff@greenacredairy.co.uk
# NML_MAILBOX_CM=steff@cwrtmalle.co.uk
# NML_LOOKBACK_DAYS=30
# Local dev: read PDFs from a folder instead of Graph mail
# LOCAL_NML_DIR=C:\Users\you\nml-reports
# The Cwrt Malle mailbox is in a SEPARATE M365 tenant, so it needs its own app
# registration (Mail.Read + admin consent). When these are set, the CM mailbox
# is read with these credentials; the GAD mailbox keeps using the GRAPH_* app.
# GRAPH_TENANT_ID_CM=
# GRAPH_CLIENT_ID_CM=
# GRAPH_CLIENT_SECRET_CM=

# Milk haulier collection reports (emailed XLSX from the haulier).
# Reuses the same Mail.Read app(s) as NML above; the Cwrt Malle report lands in
# the CM mailbox and uses the GRAPH_*_CM credentials when configured.
# Senders vary, so we match the whole domain (leading @ optional):
# HAULIER_SENDER_DOMAIN=richardthomastransport.co.uk
# HAULIER_MAILBOX_CM=steff@cwrtmalle.co.uk
# HAULIER_MAILBOX_GAD=
# HAULIER_LOOKBACK_DAYS=30
# Local dev: read XLSX reports from a folder instead of Graph mail
# LOCAL_HAULIER_DIR=C:\Users\you\haulier-reports

# Milk buyer monthly sales statements (emailed PDFs).
# Freshways (GAD) and Dairy Partners (CM); reuses the same Mail.Read app(s) as NML.
# Comma-separated if the buyer uses more than one sender domain.
# STATEMENTS_FRESHWAYS_DOMAIN=freshways.co.uk
# STATEMENTS_DAIRYPARTNERS_DOMAIN=dairypartners.co.uk
# STATEMENTS_MAILBOX_GAD=steff@greenacredairy.co.uk
# STATEMENTS_MAILBOX_CM=steff@cwrtmalle.co.uk
# STATEMENTS_LOOKBACK_DAYS=30
# STATEMENTS_DEFAULT_HAULAGE=1.0
# Local dev: read statement PDFs from a folder instead of Graph mail
# LOCAL_STATEMENTS_DIR=C:\Users\you\milk-statements
# Daily cron (haulier + NML + statements + cattle sales — yesterday and today):
# MILK_CRON_LOOKBACK_DAYS=2
#   python scripts/import_milk_daily.py
# Cron (e.g. monthly after statements arrive):
#   python scripts/import_milk_statements.py

# Cattle sale remittance PDFs (Eurofarm carcass + Pathway Farming calves).
# Comma-separated sender domains; defaults include both buyers.
# CATTLE_SALES_SENDER_DOMAIN=eurofarmwales.co.uk,pathwayfarming.co.uk
# CATTLE_SALES_MAILBOX_GAD=steff@greenacredairy.co.uk
# CATTLE_SALES_MAILBOX_CM=steff@cwrtmalle.co.uk
# CATTLE_SALES_LOOKBACK_DAYS=30
# Local dev: read PDFs from a folder instead of Graph mail
# LOCAL_CATTLE_SALES_DIR=C:\Users\you\cattle-sales-pdfs

# Parlour milk-flow reports (DelPro / Dataflow emailed after each shift)
# PARLOUR_SENDER=support@dataflow2.com
# PARLOUR_MAILBOX_GAD=steff@greenacredairy.co.uk
# PARLOUR_MAILBOX_CM=steff@cwrtmalle.co.uk
# PARLOUR_LOOKBACK_DAYS=30
# LOCAL_PARLOUR_DIR=C:\Users\you\parlour-reports

# Xero Accounting API (Office Admin → Xero)
# Register redirect URI exactly as shown on the Xero page (from PUBLIC_APP_URL).
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# Optional override if PUBLIC_APP_URL is not the OAuth host:
# XERO_REDIRECT_URI=https://www.dashboard.cwrtmalle.co.uk/api/xero/oauth/callback
# XERO_SCOPES=openid profile email offline_access accounting.invoices accounting.payments accounting.banktransactions accounting.manualjournals accounting.contacts accounting.settings

# Feedlync feed rate import (HTTP API — no browser required)
# On first deploy you can set FEEDLYNC_REFRESH_TOKEN once; after that use Feed Rate → Reconnect FeedLync.
# The app stores and rotates the token in the database automatically.
FEEDLYNC_REFRESH_TOKEN=
# Public URL of this app (OAuth callback). Defaults to RENDER_EXTERNAL_URL on Render.
# PUBLIC_APP_URL=https://your-app.onrender.com
# Optional: comma-separated farm UUIDs; if unset, all farms from /farms/summary are imported
# FEEDLYNC_FARM_ID=ca4e4709-5e57-4b3f-8f6e-08dc5df96c65

# Unattended FeedLync login (recommended for cron). FeedLync's B2C SPA refresh
# tokens expire ~24h, so a stored/pasted token won't survive between weekly runs.
# With these set, the importer logs in automatically (replicating the B2C
# sign-in flow) and refreshes the token on each run. Account must have NO MFA.
# Treat the password as a secret; never commit it.
# FEEDLYNC_USERNAME=you@example.com
# FEEDLYNC_PASSWORD=
# Registered SPA redirect URI (intercepted server-side; default is correct).
# FEEDLYNC_SPA_REDIRECT_URI=https://app.feedlync.com/redirect.html

# HR / Staff management (DocuSeal contract signing)
# DOCUSEAL_API_KEY=from DocuSeal console → API
# DOCUSEAL_BASE_URL=https://api.docuseal.com
# DOCUSEAL_WEBHOOK_SECRET=long-random-string (append to webhook URL or X-Webhook-Secret header)
# HR_ENCRYPTION_KEY=optional Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# HR reviewer emails — global fallback + per-business overrides
# HR_HR_TEAM_EMAILS=hr1@example.com,hr2@example.com
# DOCUSEAL_CM_HR_TEAM_EMAILS=hr@cwrtmalle.co.uk
# DOCUSEAL_GAD_HR_TEAM_EMAILS=hr@greenacredairy.co.uk
# CONTRACTS_STORAGE_DIR=/var/data/contracts
# DOCUSEAL_CWRTMALLE_TEMPLATE_ID=12345
# DOCUSEAL_CWRTMALLE_TEMPLATE_NAME=Cwrt Malle Employment Contract
# DOCUSEAL_GREENACRE_TEMPLATE_ID=67890
# DOCUSEAL_GREENACRE_TEMPLATE_NAME=Green Acre Dairy Employment Contract
# Customise the signer invitation email (blank = DocuSeal defaults).
# Body supports tags e.g. {{template.name}}, {{submitter.link}}, {{account.name}}
# Global is the fallback; per-business values override it.
# DOCUSEAL_EMAIL_SUBJECT=Your employment contract to sign
# DOCUSEAL_EMAIL_BODY=Hi, please review and sign your employment contract: {{submitter.link}}
# DOCUSEAL_CWRTMALLE_EMAIL_SUBJECT=Your Cwrt Malle Ltd employment contract is ready to sign
# DOCUSEAL_CWRTMALLE_EMAIL_BODY=Hi there,\n\nYou have been invited to sign the "{{template.name}}".\n\n{{submitter.link}}\n\nPlease contact us by email (office@cwrtmalle.co.uk) if you have any questions.\n\nThanks,\n\nCwrt Malle Ltd
# DOCUSEAL_GREENACRE_EMAIL_SUBJECT=Your Green Acre Dairy Ltd employment contract is ready to sign
# DOCUSEAL_GREENACRE_EMAIL_BODY=Hi there,\n\nYou have been invited to sign the "{{template.name}}".\n\n{{submitter.link}}\n\nPlease contact us by email (office@greenacredairy.co.uk) if you have any questions.\n\nThanks,\n\nGreen Acre Dairy Ltd
